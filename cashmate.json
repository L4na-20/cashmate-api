{
  "info": {
    "name": "CashMate API MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8096/api" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"business_name\": \"Demo Warung\",\n  \"name\": \"Owner Demo\",\n  \"email\": \"owner@example.test\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.data) { pm.collectionVariables.set('access_token', json.data.access_token); pm.collectionVariables.set('refresh_token', json.data.refresh_token); }"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.test\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] } }
        }
      ]
    },
    {
      "name": "Owner resources",
      "item": [
        { "name": "Staff", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/staff", "host": ["{{base_url}}"], "path": ["staff"] } } },
        { "name": "Create Staff", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Staff Demo\",\n  \"email\": \"staff@example.test\",\n  \"password\": \"password123\"\n}" }, "url": { "raw": "{{base_url}}/staff", "host": ["{{base_url}}"], "path": ["staff"] } } },
        { "name": "Wallets", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/wallets", "host": ["{{base_url}}"], "path": ["wallets"] } } },
        { "name": "Categories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } } },
        { "name": "Transactions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/transactions?page=1&per_page=15", "host": ["{{base_url}}"], "path": ["transactions"], "query": [{ "key": "page", "value": "1" }, { "key": "per_page", "value": "15" }] } } },
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/dashboard/summary", "host": ["{{base_url}}"], "path": ["dashboard", "summary"] } } },
        { "name": "Monthly report", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": { "raw": "{{base_url}}/reports/monthly?year=2026", "host": ["{{base_url}}"], "path": ["reports", "monthly"], "query": [{ "key": "year", "value": "2026" }] } } }
      ]
    },
    {
      "name": "Transactions create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"wallet_id\": 1,\n  \"category_id\": 1,\n  \"amount\": 25000,\n  \"type\": \"expense\",\n  \"description\": \"Operasional\"\n}" },
        "url": { "raw": "{{base_url}}/transactions", "host": ["{{base_url}}"], "path": ["transactions"] }
      }
    }
  ]
}
