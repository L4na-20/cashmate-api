              "host": [
                "{{base_url}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "15"
                },
                {
                  "key": "type",
                  "value": "expense"
                },
                {
                  "key": "from_date",
                  "value": "2026-01-01"
                },
                {
                  "key": "to_date",
                  "value": "2026-12-31"
                },
                {
                  "key": "wallet_id",
                  "value": "1"
                },
                {
                  "key": "category_id",
                  "value": "1"
                }
              ]
            },
            "description": "Histori transaksi milik user, terpaginasi.\n\nQuery params (semua opsional):\n- page        : halaman (default 1)\n- per_page    : jumlah per halaman, 1-100 (default 15)\n- type        : income / expense\n- from_date   : mulai tanggal (YYYY-MM-DD)\n- to_date     : sampai tanggal (YYYY-MM-DD)\n- wallet_id   : filter wallet (harus milik user)\n- category_id : filter kategori (global atau milik user)\n\nResponse 200:\n{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"wallet_id\": 1,\n      \"category_id\": 1,\n      \"amount\": 25000,\n      \"type\": \"expense\",\n      \"description\": \"Makan siang\",\n      \"date\": \"2026-09-14T00:00:00Z\",\n      \"created_at\": \"...\",\n      \"updated_at\": \"...\",\n      \"wallet\": { ... },\n      \"category\": { ... }\n    }\n  ],\n  \"total\": 10,\n  \"from\": 1,\n  \"to\": 10,\n  \"per_page\": 15,\n  \"current_page\": 1,\n  \"last_page\": 1\n}"
          },
          "response": []
        },
