              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": 1,\n  \"amount\": 25000,\n  \"type\": \"expense\",\n  \"category_id\": 1,\n  \"description\": \"Makan siang\",\n  \"date\": \"2026-09-14\"\n}"
