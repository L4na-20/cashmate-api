                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E-Money (OVO)\",\n  \"balance\": 300000,\n  \"currency\": \"IDR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/wallets/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wallets",
                "2"
              ]
            },
            "description": "Memperbarui wallet milik user. Ganti angka 2 pada URL dengan id wallet.\n\nResponse 200:\n{\n  \"message\": \"wallet berhasil diperbarui\",\n  \"data\": { ... }
}"
          },
          "response": []
        },
        {
          "name": "Delete Wallet",
          "event": [],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/wallets/2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "wallets",
                "2"
              ]
            },
            "description": "Menandai wallet sebagai NON-AKTIF (soft delete via deleted_at), data tidak dihapus permanen & transaksinya ikut tersimpan. Ganti angka 2 pada URL dengan id wallet.\n\nResponse 200:\n{\n  \"message\": \"wallet berhasil dihapus\"\n}\n\nPulihkan dengan: UPDATE wallets SET deleted_at = NULL WHERE id = <id>;"
          },
          "response": []
        }
      ]
    },
