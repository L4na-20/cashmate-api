# =========================
# CASHMATE REST API - .env
# Copy file ini menjadi .env lalu sesuaikan nilai-nilainya
# =========================

# Port server API Go
APP_PORT=8080

# Database MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=root
DB_PASSWORD=
DB_NAME=cashmate

# Kosongkan untuk mode produksi, atau set debug untuk melihat log query
APP_ENV=debug

# =========================
# KEAMANAN / JWT
# =========================
# Ganti dengan secret acak yang panjang untuk akses produksi!
JWT_SECRET=ubah_dengan_secret_acak_yang_sangat_panjang_min_32_karakter
JWT_REFRESH_SECRET=ubah_dengan_refresh_secret_acak_yang_berbeda

# Durasi berlaku token
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=168