# =========================
# CASHMATE REST API - .env
# Copy file ini menjadi .env lalu sesuaikan nilainya
# =========================

# Port server API Go (harus sama dengan EXPOSE di Dockerfile)
APP_PORT=8096
# IANA timezone used for Staff "today" and monthly boundaries.
APP_TIMEZONE=Asia/Jakarta
# Keep true only for a disposable local database. Production uses migrations/*.sql.
AUTO_MIGRATE=false

# Mode: "debug" untuk development, KOSONGKAN untuk produksi
APP_ENV=

# =========================
# DATABASE (MySQL public / hosting panel)
# =========================
# Isi dengan host MySQL public kamu (mis. dari hosting panel:
# mysql.hostinger.com, atau IP server hosting).
DB_HOST=ganti_host_mysql_public
DB_PORT=3306
DB_USER=ganti_user_mysql
DB_PASSWORD=ganti_password_mysql_yang_kuat
DB_NAME=ganti_nama_database

# =========================
# KEAMANAN / JWT
# =========================
# Wajib diganti dengan secret acak yang panjang (>32 karakter)!
# Cara generate: openssl rand -base64 48
JWT_SECRET=ganti_dengan_secret_acak_yang_sangat_panjang_min_32_karakter
JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_acak_yang_berbeda

# Durasi berlaku token
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_HOURS=168

# =========================
# CORS & PROXY
# =========================
# Origin frontend yang diizinkan mengakses API (pisahkan dengan koma, tanpa trailing slash).
# Contoh produksi: https://cashmate.example.com
CORS_ORIGINS=

# IP nginx di dalam Docker network (jangan diubah, sudah diset di docker-compose).
TRUSTED_PROXIES=172.20.0.10

# =========================
# HTTPS / LET'S ENCRYPT
# =========================
# Domain publik API, contoh: api.cashmate.com
# Kosongkan jika belum punya domain (HTTPS skip, pakai HTTP dulu).
APP_DOMAIN=
