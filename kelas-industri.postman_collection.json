        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var response = pm.response.json();\r",
                  "\r",
                  "// Ambil access_token dari dalam objek \"data\"\r",
                  "if (response.data && response.data.access_token) {\r",
                  "    pm.environment.set(\"jwt_token\", response.data.access_token);\r",
                  "    console.log(\"Token berhasil disimpan ke Environment!\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
